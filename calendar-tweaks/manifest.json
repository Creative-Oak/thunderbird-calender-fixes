{
  "manifest_version": 2,
  "name": "Calendar Tweaks",
  "version": "1.1.0",
  "description": "Calendar quality-of-life fixes: (1) dragging a time range opens the full event editor pre-filled with the dragged times; (2) emailed invitations are auto-added to the calendar as un-answered (dotted) items on arrival, without sending a reply.",
  "author": "Magnus H. Kaspersen",

  "browser_specific_settings": {
    "gecko": {
      "id": "calendar-tweaks@creativeoak.dk",
      "strict_min_version": "128.0"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "experiment_apis": {
    "dragEvent": {
      "schema": "experiments/dragEvent/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["dragEvent"]],
        "script": "experiments/dragEvent/implementation.js"
      }
    },
    "autoInvite": {
      "schema": "experiments/autoInvite/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["autoInvite"]],
        "script": "experiments/autoInvite/implementation.js"
      }
    }
  }
}
